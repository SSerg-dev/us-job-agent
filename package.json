{
  "name": "us-job-agent",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/dev.mjs",
    "build": "ng build && tsc -p tsconfig.server.json",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:server": "tsc -p tsconfig.server.json && node --test dist-server/tests/*.test.js",
    "test:ui": "ng test --watch=false",
    "test:e2e": "playwright test",
    "serve": "node dist-server/src/server/main.js"
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "jsdom": "^30.0.0",
    "postcss": "8.5.29",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
